---
import Icon from './Icon.astro';

const navItems = [
  { label: 'Articles', href: '/#articles' },
  { label: 'Architecture', href: '/categories/architecture' },
  { label: 'AI & Tech', href: '/categories/technology-ai' },
  { label: 'About', href: '/about' },
];
---

<header class="border-b border-neutral-200/80 bg-white/95 backdrop-blur-md sticky top-0 z-40 dark:border-neutral-800/80 dark:bg-neutral-950/95 transition-colors">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Brand / Logo -->
      <a href="/" class="flex items-center gap-2.5 text-neutral-900 dark:text-white group">
        <div class="flex h-8 w-8 items-center justify-center rounded-md bg-neutral-900 text-white dark:bg-white dark:text-neutral-950 shadow-sm">
          <Icon name="book-open-text" weight="bold" class="w-4 h-4" />
        </div>
        <div class="flex flex-col">
          <span class="text-base font-bold tracking-tight text-neutral-950 dark:text-white">
            The Dispatched
          </span>
          <span class="text-[10px] font-semibold tracking-widest uppercase text-neutral-500 dark:text-neutral-400">
            Systems & Engineering
          </span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-neutral-600 dark:text-neutral-400">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="transition-colors hover:text-neutral-950 dark:hover:text-white"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <!-- Right Utility Actions -->
      <div class="flex items-center gap-2 sm:gap-3">
        <!-- Search trigger button -->
        <button
          type="button"
          id="search-btn"
          aria-label="Search articles"
          class="flex items-center gap-2 rounded-md border border-neutral-200 bg-neutral-50/80 px-2.5 py-1.5 text-xs font-medium text-neutral-700 hover:text-neutral-950 hover:bg-neutral-100 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:text-white dark:hover:bg-neutral-800 transition-colors"
        >
          <Icon name="magnifying-glass" class="w-4 h-4 text-neutral-500 dark:text-neutral-400" />
          <span class="hidden sm:inline">Search</span>
          <kbd class="hidden sm:inline-block font-mono text-[10px] text-neutral-400 dark:text-neutral-500 bg-white dark:bg-neutral-800 px-1 rounded border border-neutral-200 dark:border-neutral-700">⌘K</kbd>
        </button>

        <!-- RSS Link -->
        <a
          href="/rss.xml"
          aria-label="RSS Feed"
          class="p-2 text-neutral-600 hover:text-neutral-950 hover:bg-neutral-100 rounded-md dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-800 transition-colors"
        >
          <Icon name="rss" class="w-4 h-4" />
        </a>

        <!-- Dark/Light Theme Toggle -->
        <button
          type="button"
          id="theme-toggle"
          aria-label="Toggle theme"
          class="p-2 text-neutral-600 hover:text-neutral-950 hover:bg-neutral-100 rounded-md dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-800 transition-colors border border-neutral-200/80 dark:border-neutral-800"
        >
          <span class="dark:hidden">
            <Icon name="moon" class="w-4 h-4 text-neutral-700" />
          </span>
          <span class="hidden dark:inline">
            <Icon name="sun" class="w-4 h-4 text-neutral-300" />
          </span>
        </button>

        <!-- Studio / Backend Link -->
        <a
          href="/admin"
          aria-label="Editorial Studio & GitHub Storage"
          title="Editorial Studio & GitHub Storage"
          class="p-2 text-neutral-600 hover:text-neutral-950 hover:bg-neutral-100 rounded-md dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-800 transition-colors border border-neutral-200/80 dark:border-neutral-800"
        >
          <Icon name="pencil-line" class="w-4 h-4 text-neutral-700 dark:text-neutral-300" />
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Open mobile menu"
          class="p-2 md:hidden text-neutral-600 hover:text-neutral-950 hover:bg-neutral-100 rounded-md dark:text-neutral-400 dark:hover:text-white dark:hover:bg-neutral-800"
        >
          <Icon name="list" class="w-5 h-5" />
        </button>
      </div>
    </div>

    <!-- Mobile Navigation Drawer -->
    <div
      id="mobile-menu"
      class="hidden md:hidden border-t border-neutral-200 bg-white py-4 dark:border-neutral-800 dark:bg-neutral-950"
    >
      <nav class="flex flex-col space-y-3">
        {navItems.map((item) => (
          <a
            href={item.href}
            class="text-sm font-medium text-neutral-700 hover:text-neutral-950 dark:text-neutral-300 dark:hover:text-white px-2 py-1"
          >
            {item.label}
          </a>
        ))}
      </nav>
    </div>
  </div>
</header>

<script is:inline>
  // Vanilla Theme Toggle (Zero frameworks)
  const themeBtn = document.getElementById('theme-toggle');
  if (themeBtn) {
    themeBtn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  }

  // Vanilla Mobile Menu Toggle
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileBtn && mobileMenu) {
    mobileBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }
</script>
