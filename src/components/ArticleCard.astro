---
import type { Post } from '../data/blogData';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="group flex flex-col justify-between rounded-lg border border-neutral-200/80 bg-white p-4 dark:border-neutral-800/80 dark:bg-neutral-900/40">
  <div>
    <!-- Cover Image -->
    <a href={`/posts/${post.slug}`} class="block overflow-hidden rounded-md border border-neutral-200/60 dark:border-neutral-800/60 mb-4 bg-neutral-100 dark:bg-neutral-900">
      <img
        src={post.coverImage}
        alt={post.coverAlt}
        class="w-full aspect-[16/10] object-cover group-hover:scale-[1.01] transition-transform duration-150"
        loading="lazy"
        decoding="async"
        width="600"
        height="375"
      />
    </a>

    <!-- Category & Reading Time (No pills) -->
    <div class="flex items-center gap-2 text-xs mb-2">
      <span class="inline-flex items-center gap-1.5 font-semibold text-neutral-900 dark:text-neutral-200 uppercase tracking-wider text-[11px]">
        <span class={`w-1.5 h-1.5 rounded-full ${post.categoryColor}`}></span>
        {post.category}
      </span>
      <span class="text-neutral-300 dark:text-neutral-700">•</span>
      <span class="inline-flex items-center gap-1 text-neutral-500 dark:text-neutral-400">
        <Icon name="clock" class="w-3.5 h-3.5" />
        {post.readTime}
      </span>
    </div>

    <!-- Title -->
    <h3 class="text-base font-bold tracking-tight text-neutral-950 dark:text-white leading-snug mb-2 group-hover:underline underline-offset-2">
      <a href={`/posts/${post.slug}`}>
        {post.title}
      </a>
    </h3>

    <!-- Excerpt -->
    <p class="text-xs text-neutral-600 dark:text-neutral-300 line-clamp-3 leading-relaxed mb-4">
      {post.excerpt}
    </p>
  </div>

  <!-- Footer Info -->
  <div class="flex items-center justify-between border-t border-neutral-100 dark:border-neutral-800/80 pt-3 mt-2 text-xs">
    <div class="flex items-center gap-2">
      <img
        src={post.author.avatar}
        alt={post.author.name}
        class="w-5 h-5 rounded-full object-cover"
        loading="lazy"
        width="20"
        height="20"
      />
      <span class="text-neutral-700 dark:text-neutral-300 font-medium">
        {post.author.name}
      </span>
    </div>
    <span class="text-neutral-400 dark:text-neutral-500 text-[11px]">
      {post.publishedAt}
    </span>
  </div>
</article>
