---
import type { Post } from '../data/blogData';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article class="border-b border-neutral-200 pb-12 pt-4 dark:border-neutral-800">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
    <!-- Visual Cover Image (Optimized for LCP: eager + high priority) -->
    <div class="lg:col-span-7">
      <a href={`/posts/${post.slug}`} class="block group overflow-hidden rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100 dark:bg-neutral-900">
        <img
          src={post.coverImage}
          alt={post.coverAlt}
          class="w-full aspect-[16/10] object-cover group-hover:scale-[1.01] transition-transform duration-200"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="1200"
          height="750"
        />
      </a>
    </div>

    <!-- Editorial Content -->
    <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
      <div>
        <!-- Category & Time (Strictly NO border/background pills) -->
        <div class="flex items-center gap-2.5 text-xs tracking-wider uppercase mb-3">
          <span class="inline-flex items-center gap-1.5 font-semibold text-neutral-900 dark:text-neutral-100">
            <span class={`w-2 h-2 rounded-full ${post.categoryColor}`}></span>
            {post.category}
          </span>
          <span class="text-neutral-400 dark:text-neutral-600">•</span>
          <span class="inline-flex items-center gap-1 text-neutral-500 dark:text-neutral-400 normal-case font-medium">
            <Icon name="clock" class="w-3.5 h-3.5 text-neutral-400" />
            {post.readTime}
          </span>
          <span class="text-neutral-400 dark:text-neutral-600">•</span>
          <span class="inline-flex items-center gap-1 text-neutral-500 dark:text-neutral-400 normal-case font-medium">
            <Icon name="calendar-blank" class="w-3.5 h-3.5 text-neutral-400" />
            {post.publishedAt}
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-neutral-950 dark:text-white leading-[1.2] mb-3">
          <a href={`/posts/${post.slug}`} class="hover:underline decoration-neutral-400 underline-offset-4">
            {post.title}
          </a>
        </h1>

        <!-- Excerpt -->
        <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
          {post.excerpt}
        </p>
      </div>

      <!-- Author Bio Line & Action -->
      <div class="flex flex-wrap items-center justify-between gap-4 pt-4 border-t border-neutral-100 dark:border-neutral-900">
        <div class="flex items-center gap-3">
          <img
            src={post.author.avatar}
            alt={post.author.name}
            class="w-10 h-10 rounded-full object-cover ring-1 ring-neutral-200 dark:ring-neutral-800"
            loading="eager"
            width="40"
            height="40"
          />
          <div>
            <div class="text-sm font-semibold text-neutral-950 dark:text-white">
              {post.author.name}
            </div>
            <div class="text-xs text-neutral-500 dark:text-neutral-400">
              {post.author.role}
            </div>
          </div>
        </div>

        <a
          href={`/posts/${post.slug}`}
          class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-neutral-950 dark:text-white hover:text-neutral-600 dark:hover:text-neutral-300 group"
        >
          <span>Read Essay</span>
          <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </div>
</article>
