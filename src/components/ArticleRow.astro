---
import type { Post } from '../data/blogData';
import Icon from './Icon.astro';

interface Props {
  post: Post;
}

const { post } = Astro.props;
---

<article
  class="article-item group py-6 border-b border-neutral-200/80 last:border-b-0 dark:border-neutral-800/80"
  data-category={post.categorySlug}
>
  <div class="flex flex-col-reverse sm:flex-row gap-5 sm:gap-6 items-start justify-between">
    <!-- Left: Content Details -->
    <div class="flex-1 flex flex-col justify-between space-y-2.5">
      <!-- Top Meta: Category, Date, Read Time -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs">
        <span class="inline-flex items-center gap-1.5 font-semibold text-neutral-900 dark:text-neutral-200 uppercase tracking-wider text-[11px]">
          <span class={`w-1.5 h-1.5 rounded-full ${post.categoryColor}`}></span>
          {post.category}
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span class="inline-flex items-center gap-1 text-neutral-500 dark:text-neutral-400">
          <Icon name="calendar-blank" class="w-3.5 h-3.5" />
          {post.publishedAt}
        </span>
        <span class="text-neutral-300 dark:text-neutral-700">•</span>
        <span class="inline-flex items-center gap-1 text-neutral-500 dark:text-neutral-400">
          <Icon name="clock" class="w-3.5 h-3.5" />
          {post.readTime}
        </span>
      </div>

      <!-- Headline -->
      <h3 class="text-lg sm:text-xl font-bold tracking-tight text-neutral-950 dark:text-white leading-snug">
        <a href={`/posts/${post.slug}`} class="group-hover:underline decoration-neutral-400 underline-offset-4">
          {post.title}
        </a>
      </h3>

      <!-- Excerpt -->
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed line-clamp-2 max-w-2xl">
        {post.excerpt}
      </p>

      <!-- Author Line & Action -->
      <div class="flex items-center justify-between pt-2">
        <div class="flex items-center gap-2">
          <img
            src={post.author.avatar}
            alt={post.author.name}
            class="w-5 h-5 rounded-full object-cover ring-1 ring-neutral-200 dark:ring-neutral-800"
            loading="lazy"
            width="20"
            height="20"
          />
          <span class="text-xs font-medium text-neutral-800 dark:text-neutral-200">
            {post.author.name}
          </span>
          <span class="text-xs text-neutral-400 dark:text-neutral-500 hidden md:inline">
            • {post.author.role}
          </span>
        </div>

        <div class="flex items-center gap-3">
          <button
            type="button"
            aria-label="Save article"
            class="p-1 text-neutral-400 hover:text-neutral-950 dark:text-neutral-500 dark:hover:text-white transition-colors"
          >
            <Icon name="bookmark-simple" class="w-4 h-4" />
          </button>
          <a
            href={`/posts/${post.slug}`}
            class="hidden sm:inline-flex items-center gap-1 text-xs font-semibold text-neutral-900 dark:text-white hover:text-neutral-600 dark:hover:text-neutral-300"
          >
            <span>Read</span>
            <Icon name="arrow-right" class="w-3.5 h-3.5" />
          </a>
        </div>
      </div>
    </div>

    <!-- Right: Article Thumbnail Image -->
    <a
      href={`/posts/${post.slug}`}
      class="w-full sm:w-44 md:w-48 aspect-[16/10] shrink-0 overflow-hidden rounded-md border border-neutral-200/80 bg-neutral-100 dark:border-neutral-800/80 dark:bg-neutral-900"
    >
      <img
        src={post.coverImage}
        alt={post.coverAlt}
        class="w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-150"
        loading="lazy"
        decoding="async"
        width="400"
        height="250"
      />
    </a>
  </div>
</article>
