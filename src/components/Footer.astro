---
import Icon from './Icon.astro';
---

<footer class="border-t border-neutral-200/80 bg-neutral-50 text-neutral-600 dark:border-neutral-800 dark:bg-neutral-950 dark:text-neutral-400 mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
      <!-- Col 1: Masthead Info -->
      <div class="md:col-span-1 space-y-4">
        <div class="flex items-center gap-2.5 text-neutral-950 dark:text-white">
          <div class="flex h-7 w-7 items-center justify-center rounded-sm bg-neutral-900 text-white dark:bg-white dark:text-neutral-950">
            <Icon name="book-open-text" weight="bold" class="w-3.5 h-3.5" />
          </div>
          <span class="text-sm font-semibold tracking-tight">The Dispatched</span>
        </div>
        <p class="text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
          An independent technical journal dedicated to software craftsmanship, distributed systems reliability, and durable engineering practices.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white">
          Publications
        </h4>
        <ul class="space-y-2 text-xs">
          <li><a href="/#articles" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Latest Essays</a></li>
          <li><a href="/categories/architecture" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Distributed Systems</a></li>
          <li><a href="/categories/technology-ai" class="hover:text-neutral-950 dark:hover:text-white transition-colors">Artificial Intelligence</a></li>
          <li><a href="/about" class="hover:text-neutral-950 dark:hover:text-white transition-colors">About the Journal</a></li>
          <li><a href="/admin" class="hover:text-neutral-950 dark:hover:text-white transition-colors font-medium">Editorial Studio (GitHub CMS)</a></li>
        </ul>
      </div>

      <!-- Col 3: Standards & Feeds -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white">
          Feeds & Protocol
        </h4>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="/rss.xml" class="flex items-center gap-1.5 hover:text-neutral-950 dark:hover:text-white transition-colors">
              <Icon name="rss" class="w-3.5 h-3.5" />
              <span>RSS 2.0 Feed</span>
            </a>
          </li>
          <li>
            <a href="/atom.xml" class="flex items-center gap-1.5 hover:text-neutral-950 dark:hover:text-white transition-colors">
              <Icon name="rss" class="w-3.5 h-3.5" />
              <span>Atom Syndication</span>
            </a>
          </li>
          <li>
            <a href="/jsonfeed.json" class="flex items-center gap-1.5 hover:text-neutral-950 dark:hover:text-white transition-colors">
              <Icon name="file-code" class="w-3.5 h-3.5" />
              <span>JSON Feed 1.1</span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Colophon -->
      <div class="space-y-3">
        <h4 class="text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white">
          Colophon
        </h4>
        <p class="text-xs leading-relaxed text-neutral-500 dark:text-neutral-400">
          Built with <a href="https://astro.build" class="underline hover:text-neutral-950 dark:hover:text-white" target="_blank" rel="noopener">Astro</a>, <a href="https://tailwindcss.com" class="underline hover:text-neutral-950 dark:hover:text-white" target="_blank" rel="noopener">Tailwind CSS</a>, and <a href="https://phosphoricons.com" class="underline hover:text-neutral-950 dark:hover:text-white" target="_blank" rel="noopener">Phosphor Icons</a>.
        </p>
        <p class="text-xs text-neutral-400 dark:text-neutral-500">
          Zero JS runtime frameworks. Content-first and accessible.
        </p>
      </div>
    </div>

    <!-- Bottom Copyright -->
    <div class="mt-12 pt-8 border-t border-neutral-200/80 dark:border-neutral-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-neutral-500 dark:text-neutral-400">
      <div>
        &copy; {new Date().getFullYear()} The Dispatched Journal. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <a href="#privacy" class="hover:underline">Privacy Notice</a>
        <a href="#terms" class="hover:underline">Terms of Use</a>
        <a href="#license" class="hover:underline">Open Source</a>
      </div>
    </div>
  </div>
</footer>
