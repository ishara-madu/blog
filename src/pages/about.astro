---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { authors } from '../data/blogData';

const authorList = Object.values(authors);

const principles = [
  {
    number: '01',
    title: 'Content-First & Framework-Free',
    description: 'We believe standard web platform primitives (HTML, CSS, Web APIs) outlive JavaScript framework churn. We design interfaces for zero-latency, sub-100ms loading, and unhurried readability.',
  },
  {
    number: '02',
    title: 'Empirical Systems Architecture',
    description: 'We reject marketing buzzwords. Every investigation published in this journal is backed by reproducible benchmarks, distributed stress tests, and real-world production incident postmortems.',
  },
  {
    number: '03',
    title: 'Deliberate Craftsmanship',
    description: 'Great engineering is deliberate, unhurried, and deeply considered. We prioritize long-term maintainability, code clarity, and architectural integrity over frantic shipping velocity.',
  },
];
---

<Layout
  title="About The Dispatched — Editorial Mission & Board"
  description="The Dispatched is an independent engineering journal dedicated to distributed systems architecture, artificial intelligence foundations, and software craftsmanship."
>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-neutral-500 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors"
      >
        <Icon name="arrow-left" class="w-3.5 h-3.5" />
        <span>Back to Dispatches</span>
      </a>
    </div>

    <!-- Editorial Masthead Header -->
    <header class="max-w-3xl border-b border-neutral-200/80 pb-10 dark:border-neutral-800/80">
      <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-2">
        <span class="w-2 h-2 rounded-full bg-neutral-900 dark:bg-white"></span>
        Publication Colophon
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white leading-tight">
        Engineering With Rigor, Craft & Longevity
      </h1>
      <p class="mt-4 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
        <strong class="text-neutral-950 dark:text-white font-semibold">The Dispatched</strong> is an independent technical publication produced by practicing systems architects, AI research engineers, and product designers.
      </p>
    </header>

    <!-- Core Editorial Principles -->
    <section class="mt-14" aria-label="Editorial Principles">
      <div class="mb-8">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
          Our Editorial Principles
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          The values that govern what we investigate, how we benchmark, and how we write.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {principles.map((principle) => (
          <div class="border-t-2 border-neutral-900 pt-5 dark:border-neutral-100 flex flex-col justify-between">
            <div>
              <span class="font-mono text-xs font-bold text-neutral-400 dark:text-neutral-500 mb-2 block">
                {principle.number}
              </span>
              <h3 class="text-base font-bold text-neutral-950 dark:text-white mb-2">
                {principle.title}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {principle.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Editorial Board / Author Profile -->
    <section class="mt-20 border-t border-neutral-200 pt-12 dark:border-neutral-800" aria-label="Author Profile">
      <div class="mb-8">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
          {authorList.length > 1 ? "Editorial Board & Staff Contributors" : "Publisher & Principal Author"}
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          {authorList.length > 1 ? "Experienced practitioners writing from active production trenches." : "Independent software engineer and systems architect writing from active production trenches."}
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {authorList.map((author) => (
          <div class="group rounded-lg border border-neutral-200 bg-white p-6 dark:border-neutral-800 dark:bg-neutral-900/30 flex flex-col justify-between">
            <div>
              <img
                src={author.avatar}
                alt={author.name}
                class="w-16 h-16 rounded-full object-cover mb-4 ring-1 ring-neutral-200 dark:ring-neutral-800"
                loading="lazy"
                width="64"
                height="64"
              />
              <h3 class="text-base font-bold text-neutral-950 dark:text-white">
                {author.name}
              </h3>
              <div class="text-xs text-neutral-500 dark:text-neutral-400 mb-2">
                {author.role}
              </div>
              <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
                {author.bio}
              </p>
            </div>
            <div class="pt-3 border-t border-neutral-100 dark:border-neutral-800 flex items-center justify-between text-xs">
              <span class="font-mono text-neutral-500 dark:text-neutral-400">{author.handle}</span>
              <a
                href={author.followUrl || (author.handle.startsWith('http') ? author.handle : `https://github.com/${author.handle.replace('@', '')}`)}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1 font-semibold text-neutral-900 dark:text-white hover:underline"
              >
                <span>Follow</span>
                <Icon name="arrow-up-right" class="w-3 h-3" />
              </a>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Colophon & Pitch Submission -->
    <div class="mt-20 grid grid-cols-1 lg:grid-cols-12 gap-10 border-t border-neutral-200 pt-12 dark:border-neutral-800 items-start">
      <!-- Colophon Details (8 cols) -->
      <div class="lg:col-span-7 space-y-4">
        <h2 class="text-lg font-bold tracking-tight text-neutral-950 dark:text-white">
          Technical Architecture & Open Standards
        </h2>
        <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
          This site is rendered entirely to static HTML via <a href="https://astro.build" class="underline hover:text-neutral-950 dark:hover:text-white font-medium" target="_blank" rel="noopener">Astro</a>, styled using <a href="https://tailwindcss.com" class="underline hover:text-neutral-950 dark:hover:text-white font-medium" target="_blank" rel="noopener">Tailwind CSS</a>, and unified through <a href="https://phosphoricons.com" class="underline hover:text-neutral-950 dark:hover:text-white font-medium" target="_blank" rel="noopener">Phosphor Icons</a>.
        </p>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
          We ship zero client-side JavaScript UI frameworks (no React, no Alpine, no Framer Motion), ensuring maximum battery life, zero hydration delays, and instant accessibility on all global networks.
        </p>
      </div>

      <!-- Pitch / Contact Box (5 cols) -->
      <div class="lg:col-span-5 rounded-lg border border-neutral-200 bg-neutral-50 p-6 dark:border-neutral-800 dark:bg-neutral-900/40">
        <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white mb-2">
          <Icon name="paper-plane-tilt" class="w-4 h-4" />
          Technical Collaboration & Questions
        </div>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
          Have feedback, questions, or architectural suggestions? Join the open discussions or open an issue directly in our GitHub repository.
        </p>
        <a
          href="https://github.com/ishara-madu/blog"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 w-full rounded-md bg-neutral-900 px-4 py-2 text-xs font-semibold text-white hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-100 transition-colors"
        >
          <span>View GitHub Repository</span>
          <Icon name="arrow-up-right" class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
