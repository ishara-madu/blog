---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Icon from '../../components/Icon.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { categories, posts, type Category } from '../../data/blogData';

export async function getStaticPaths() {
  return categories.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;

// Filter posts belonging to this category
const categoryPosts = posts.filter((p) => p.categorySlug === category.slug);
const leadPost = categoryPosts[0];
const otherPosts = categoryPosts.slice(1);
const otherCategories = categories.filter((c) => c.slug !== category.slug);
---

<Layout
  title={`${category.name} Articles — The Dispatched`}
  description={category.description}
>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12">
    <!-- Breadcrumb -->
    <div class="mb-6">
      <a
        href="/"
        class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-neutral-500 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white transition-colors"
      >
        <Icon name="arrow-left" class="w-3.5 h-3.5" />
        <span>All Dispatches</span>
      </a>
    </div>

    <!-- Category Editorial Masthead -->
    <header class="border-b border-neutral-200/80 pb-10 dark:border-neutral-800/80">
      <div class="flex flex-col sm:flex-row sm:items-start justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <!-- Icon & Category Title -->
          <div class="flex items-center gap-3">
            <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-neutral-200 bg-white text-neutral-900 dark:border-neutral-800 dark:bg-neutral-900 dark:text-white">
              <Icon name={category.icon} weight="bold" class="w-5 h-5" />
            </div>
            <div>
              <span class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
                <span class={`w-1.5 h-1.5 rounded-full ${category.color}`}></span>
                Editorial Domain
              </span>
              <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-950 dark:text-white leading-tight">
                {category.name}
              </h1>
            </div>
          </div>

          <!-- Description -->
          <p class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed pt-1">
            {category.description}
          </p>
        </div>

        <!-- Metrics Box (Minimal, subtle borders, no colored pills) -->
        <div class="sm:self-end flex items-center gap-6 text-xs text-neutral-500 dark:text-neutral-400 border-t sm:border-t-0 sm:border-l border-neutral-200 sm:pl-6 pt-4 sm:pt-0 dark:border-neutral-800">
          <div>
            <div class="text-xs uppercase font-semibold tracking-wider text-neutral-400 dark:text-neutral-500">
              Essays
            </div>
            <div class="text-xl font-bold font-mono text-neutral-950 dark:text-white">
              {category.count}
            </div>
          </div>
          <div>
            <div class="text-xs uppercase font-semibold tracking-wider text-neutral-400 dark:text-neutral-500">
              Curriculum
            </div>
            <div class="text-xl font-bold font-mono text-neutral-950 dark:text-white">
              Active
            </div>
          </div>
        </div>
      </div>
    </header>

    <!-- Category Lead Story (If available) -->
    {leadPost && (
      <section class="mt-10 border-b border-neutral-200/80 pb-12 dark:border-neutral-800/80" aria-label="Lead Category Essay">
        <div class="mb-4">
          <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
            Domain Flagship Investigation
          </h2>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          <div class="lg:col-span-7">
            <a href={`/posts/${leadPost.slug}`} class="block overflow-hidden rounded-lg border border-neutral-200/80 dark:border-neutral-800/80 bg-neutral-100 dark:bg-neutral-900 group">
              <img
                src={leadPost.coverImage}
                alt={leadPost.coverAlt}
                class="w-full aspect-[16/10] object-cover group-hover:scale-[1.01] transition-transform duration-150"
                loading="eager"
                width="1200"
                height="750"
              />
            </a>
          </div>

          <div class="lg:col-span-5 space-y-4">
            <div class="flex items-center gap-2 text-xs text-neutral-500 dark:text-neutral-400">
              <span class="inline-flex items-center gap-1 font-medium">
                <Icon name="calendar-blank" class="w-3.5 h-3.5 text-neutral-400" />
                {leadPost.publishedAt}
              </span>
              <span>•</span>
              <span class="inline-flex items-center gap-1 font-medium">
                <Icon name="clock" class="w-3.5 h-3.5 text-neutral-400" />
                {leadPost.readTime}
              </span>
            </div>

            <h3 class="text-2xl sm:text-3xl font-bold tracking-tight text-neutral-950 dark:text-white leading-snug">
              <a href={`/posts/${leadPost.slug}`} class="hover:underline decoration-neutral-400 underline-offset-4">
                {leadPost.title}
              </a>
            </h3>

            <p class="text-sm sm:text-base text-neutral-600 dark:text-neutral-300 leading-relaxed">
              {leadPost.excerpt}
            </p>

            <div class="flex items-center justify-between pt-4 border-t border-neutral-100 dark:border-neutral-900">
              <div class="flex items-center gap-2.5">
                <img
                  src={leadPost.author.avatar}
                  alt={leadPost.author.name}
                  class="w-8 h-8 rounded-full object-cover"
                  loading="lazy"
                  width="32"
                  height="32"
                />
                <div class="text-xs">
                  <div class="font-semibold text-neutral-950 dark:text-white">
                    {leadPost.author.followUrl ? (
                      <a href={leadPost.author.followUrl} target="_blank" rel="noopener noreferrer" class="hover:underline">
                        {leadPost.author.name}
                      </a>
                    ) : (
                      leadPost.author.name
                    )}
                  </div>
                  <div class="text-neutral-400 dark:text-neutral-500">
                    {leadPost.author.role}
                  </div>
                </div>
              </div>

              <a
                href={`/posts/${leadPost.slug}`}
                class="inline-flex items-center gap-1 text-xs font-semibold text-neutral-950 dark:text-white hover:underline"
              >
                <span>Read Full Essay</span>
                <Icon name="arrow-right" class="w-3.5 h-3.5" />
              </a>
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Category Feed Grid & Sidebar -->
    <div class="mt-14 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Category Articles (lg:col-span-8) -->
      <section class="lg:col-span-8" aria-label="Category Archive">
        <div class="border-b border-neutral-200 pb-3 mb-6 dark:border-neutral-800">
          <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
            All {category.name} Articles
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
            Chronological archive of research notes and systems analysis.
          </p>
        </div>

        {categoryPosts.length > 0 ? (
          <div class="flex flex-col">
            {categoryPosts.map((post) => (
              <ArticleRow post={post} />
            ))}
          </div>
        ) : (
          <div class="py-16 text-center text-neutral-500 dark:text-neutral-400">
            <Icon name="magnifying-glass" class="w-8 h-8 mx-auto mb-2 text-neutral-400" />
            <p class="text-sm font-medium">No articles published in this category yet.</p>
          </div>
        )}
      </section>

      <!-- Right: Category Sidebar (lg:col-span-4) -->
      <aside class="lg:col-span-4 space-y-10 lg:sticky lg:top-24">
        <!-- Explore Other Categories -->
        <div class="border-t-2 border-neutral-900 pt-5 dark:border-neutral-100">
          <h3 class="text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white mb-4">
            Other Technical Domains
          </h3>
          <ul class="space-y-3">
            {otherCategories.map((cat) => (
              <li>
                <a
                  href={`/categories/${cat.slug}`}
                  class="flex items-center justify-between text-sm text-neutral-700 hover:text-neutral-950 dark:text-neutral-300 dark:hover:text-white transition-colors group"
                >
                  <span class="flex items-center gap-2.5">
                    <Icon name={cat.icon} class="w-4 h-4 text-neutral-500 group-hover:text-neutral-950 dark:text-neutral-400 dark:group-hover:text-white" />
                    <span class="group-hover:underline text-xs sm:text-sm">{cat.name}</span>
                  </span>
                  <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">
                    {cat.count}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Discipline Dispatch Box -->
        <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-5 dark:border-neutral-800 dark:bg-neutral-900/30">
          <div class="flex items-center gap-2 text-xs font-bold uppercase tracking-wider text-neutral-950 dark:text-white mb-2">
            <Icon name="envelope-simple" weight="bold" class="w-4 h-4" />
            {category.name} Alerts
          </div>
          <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
            Get email updates whenever an in-depth paper is published in {category.name}.
          </p>
          <form class="space-y-2" onsubmit="event.preventDefault(); alert('Subscribed to domain alerts!');">
            <input
              type="email"
              required
              placeholder="engineer@domain.com"
              class="w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-xs text-neutral-900 placeholder:text-neutral-400 focus:border-neutral-900 focus:outline-none dark:border-neutral-700 dark:bg-neutral-950 dark:text-white"
            />
            <button
              type="submit"
              class="w-full rounded-md bg-neutral-900 px-3 py-2 text-xs font-semibold text-white hover:bg-neutral-800 dark:bg-white dark:text-neutral-900 dark:hover:bg-neutral-100 transition-colors"
            >
              Get Domain Dispatches
            </button>
          </form>
        </div>
      </aside>
    </div>
  </main>

  <Footer />
</Layout>
