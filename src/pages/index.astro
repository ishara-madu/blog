---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import FeaturedPost from '../components/FeaturedPost.astro';
import ArticleCard from '../components/ArticleCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { posts, categories } from '../data/blogData';

const featuredPost = posts.find((p) => p.featured) || posts[0];
const trendingPosts = posts.filter((p) => p.trending);
const feedPosts = posts.filter((p) => p.id !== featuredPost.id);
---

<Layout
  title="The Dispatched — Systems, AI & Software Engineering Journal"
  description="High-craft technical publication featuring in-depth articles on distributed architecture, artificial intelligence, product design, and cloud systems."
>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 sm:pt-12">
    <!-- Publication Masthead & Category Switcher -->
    <div class="border-b border-neutral-200/80 pb-6 dark:border-neutral-800/80">
      <div class="max-w-3xl">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-neutral-950 dark:text-white">
          The Dispatched Journal
        </h1>
        <p class="mt-3 text-base sm:text-lg text-neutral-600 dark:text-neutral-300 leading-relaxed">
          Critical essays, technical monographs, and architectural postmortems across five core engineering disciplines.
        </p>
      </div>

      <!-- Category Filter Tabs (Pure typography, strictly NO bordered pill boxes) -->
      <nav
        class="mt-8 flex items-center gap-6 overflow-x-auto text-sm border-t border-neutral-200/70 pt-4 dark:border-neutral-800/70 no-scrollbar"
        aria-label="Category Filter"
      >
        <button
          type="button"
          class="category-tab active-tab font-semibold text-neutral-950 dark:text-white border-b-2 border-neutral-950 dark:border-white pb-2 whitespace-nowrap transition-colors"
          data-category="all"
        >
          All Categories ({posts.length})
        </button>
        {categories.map((cat) => (
          <button
            type="button"
            class="category-tab text-neutral-500 hover:text-neutral-950 dark:text-neutral-400 dark:hover:text-white border-b-2 border-transparent pb-2 whitespace-nowrap transition-colors flex items-center gap-2"
            data-category={cat.slug}
          >
            <span class={`w-1.5 h-1.5 rounded-full ${cat.color}`}></span>
            <span>{cat.name}</span>
            <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">({cat.count})</span>
          </button>
        ))}
      </nav>
    </div>

    <!-- Lead Featured Article -->
    <section class="mt-8" aria-label="Lead Editorial Article">
      <div class="mb-3">
        <h2 class="text-xs font-bold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
          Featured Editorial Article
        </h2>
      </div>
      <FeaturedPost post={featuredPost} />
    </section>

    <!-- Trending Across Categories (3-Column Visual Article Cards) -->
    <section class="mt-14" aria-label="Trending Stories">
      <!-- Section Header (Clean, natural, typographic, strictly NO right-side floating badges) -->
      <div class="border-b border-neutral-200 pb-3 mb-6 dark:border-neutral-800">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
          Trending Across Domains
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          High-impact papers and visual guides generating discussion among senior engineers this week.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {trendingPosts.map((post) => (
          <ArticleCard post={post} />
        ))}
      </div>
    </section>

    <!-- Main Two-Column Layout: Latest Articles & Sidebar -->
    <div class="mt-16 grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Left: Comprehensive Feed (lg:col-span-8) -->
      <section class="lg:col-span-8" id="articles" aria-label="Latest Articles Feed">
        <!-- Section Header (Typographic, strictly NO floating pills) -->
        <div class="border-b border-neutral-200 pb-3 dark:border-neutral-800 flex items-center justify-between">
          <div>
            <h2 id="feed-heading" class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
              Latest Articles
            </h2>
            <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
              Read in-depth monographs with architectural diagrams and benchmark data.
            </p>
          </div>
        </div>

        <!-- Filterable Article List with Horizontal Cover Image Thumbnails -->
        <div id="articles-container" class="flex flex-col">
          {feedPosts.map((post) => (
            <ArticleRow post={post} />
          ))}
        </div>

        <!-- Empty state if category has no posts -->
        <div id="no-articles" class="hidden py-16 text-center text-neutral-500 dark:text-neutral-400">
          <Icon name="magnifying-glass" class="w-8 h-8 mx-auto mb-2 text-neutral-400" />
          <p class="text-sm font-medium">No articles found in this category yet.</p>
        </div>

        <!-- Real Repository Count Bar -->
        <div class="flex items-center justify-between border-t border-neutral-200/80 pt-6 mt-6 text-xs text-neutral-500 dark:border-neutral-800/80 dark:text-neutral-400">
          <div>
            Showing <strong class="text-neutral-900 dark:text-white font-medium">{feedPosts.length}</strong> dispatches ({posts.length} total across repository)
          </div>
          <div class="flex items-center gap-3">
            <a
              href="/rss.xml"
              class="inline-flex items-center gap-1.5 hover:text-neutral-950 dark:hover:text-white transition-colors"
            >
              <Icon name="rss" class="w-3.5 h-3.5" />
              <span>RSS Feed</span>
            </a>
            <a
              href="https://github.com/ishara-madu/blog"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-neutral-800 dark:text-neutral-200 hover:underline font-medium"
            >
              <Icon name="github-logo" class="w-3.5 h-3.5" />
              <span>GitHub Repository</span>
            </a>
          </div>
        </div>
      </section>

      <!-- Right: Cohesive Sidebar (lg:col-span-4) -->
      <div class="lg:col-span-4 lg:sticky lg:top-24">
        <Sidebar />
      </div>
    </div>

    <!-- Explore by Category Section -->
    <section class="mt-20 border-t border-neutral-200 pt-10 dark:border-neutral-800" aria-label="Explore Categories">
      <div class="mb-6">
        <h2 class="text-xl font-bold tracking-tight text-neutral-950 dark:text-white">
          Explore by Editorial Discipline
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400 mt-1">
          Deep dives into specialized technical domains authored by domain specialists.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {categories.map((cat) => (
          <a
            href={`/categories/${cat.slug}`}
            class="group p-5 rounded-lg border border-neutral-200 bg-white hover:border-neutral-400 dark:border-neutral-800 dark:bg-neutral-900/30 dark:hover:border-neutral-600 transition-colors flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between gap-2 mb-3">
                <div class="flex items-center gap-2 text-neutral-900 dark:text-white">
                  <Icon name={cat.icon} weight="bold" class="w-5 h-5 text-neutral-700 dark:text-neutral-300" />
                  <span class="text-sm font-bold group-hover:underline">{cat.name}</span>
                </div>
                <span class="text-xs font-mono text-neutral-400 dark:text-neutral-500">
                  {cat.count} essays
                </span>
              </div>
              <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed mb-4">
                {cat.description}
              </p>
            </div>
            <div class="flex items-center gap-1.5 text-xs font-semibold text-neutral-950 dark:text-white group-hover:gap-2 transition-all">
              <span>View Articles</span>
              <Icon name="arrow-right" class="w-3.5 h-3.5" />
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script is:inline>
  // Vanilla Category Filter (Zero JS framework dependencies)
  const tabs = document.querySelectorAll('.category-tab');
  const articles = document.querySelectorAll('.article-item');
  const noArticles = document.getElementById('no-articles');
  const feedHeading = document.getElementById('feed-heading');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      // Update active tab styles
      tabs.forEach((t) => {
        t.classList.remove('active-tab', 'font-semibold', 'text-neutral-950', 'dark:text-white', 'border-neutral-950', 'dark:border-white');
        t.classList.add('text-neutral-500', 'dark:text-neutral-400', 'border-transparent');
      });

      tab.classList.add('active-tab', 'font-semibold', 'text-neutral-950', 'dark:text-white', 'border-neutral-950', 'dark:border-white');
      tab.classList.remove('text-neutral-500', 'dark:text-neutral-400', 'border-transparent');

      const selectedCategory = tab.getAttribute('data-category');
      let visibleCount = 0;

      articles.forEach((item) => {
        const itemCategory = item.getAttribute('data-category');
        if (selectedCategory === 'all' || itemCategory === selectedCategory) {
          item.classList.remove('hidden');
          visibleCount++;
        } else {
          item.classList.add('hidden');
        }
      });

      if (noArticles) {
        if (visibleCount === 0) {
          noArticles.classList.remove('hidden');
        } else {
          noArticles.classList.add('hidden');
        }
      }

      if (feedHeading) {
        if (selectedCategory === 'all') {
          feedHeading.textContent = 'Latest Articles';
        } else {
          const tabText = tab.querySelector('span:first-of-type')?.textContent || 'Category';
          feedHeading.textContent = `${tabText} Articles`;
        }
      }
    });
  });
</script>
